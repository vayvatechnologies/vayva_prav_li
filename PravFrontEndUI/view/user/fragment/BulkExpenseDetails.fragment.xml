
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="bulkExpenseDetailsDialog"
        title="Additional Expense Details"
        contentWidth="650px"
        contentHeight="auto"
        stretchOnPhone="true"
        draggable="true"
        resizable="true">

        <content>
            <VBox class="sapUiMediumMargin" width="auto">

                <ObjectStatus
                    title="Expense Row"
                    text="{bulkExpenseModel>rowNumber}"
                    state="Information"
                    class="sapUiSmallMarginBottom"/>

                <Label text="Merchant Name"/>
                <Input
                    value="{bulkExpenseModel>merchant_name}"
                    placeholder="Enter merchant name"
                    width="100%"/>

                <Label
                    text="With Whom"
                    class="sapUiSmallMarginTop"/>
                <Input
                    value="{bulkExpenseModel>with_whom}"
                    placeholder="Enter person name"
                    width="100%"/>

                <Label
                    text="Cycle"
                    class="sapUiSmallMarginTop"/>
                <ComboBox
                    width="100%"
                    selectedKey="{bulkExpenseModel>cycle}"
                    items="{bulkExpenseModel>/cycles}">
                    <core:Item
                        key="{bulkExpenseModel>key}"
                        text="{bulkExpenseModel>text}"/>
                </ComboBox>

                <Label
                    text="Expense Mood"
                    class="sapUiSmallMarginTop"/>
                <ComboBox
                    width="100%"
                    selectedKey="{bulkExpenseModel>expense_mood}"
                    items="{bulkExpenseModel>/moods}">
                    <core:Item
                        key="{bulkExpenseModel>key}"
                        text="{bulkExpenseModel>text}"/>
                </ComboBox>

                <Label
                    text="Impact Saving"
                    class="sapUiSmallMarginTop"/>
                <Switch
                    state="{bulkExpenseModel>saving_impact}"
                    customTextOn="Yes"
                    customTextOff="No"/>

                <Label
                    text="Is Planned"
                    class="sapUiSmallMarginTop"/>
                <Switch
                    state="{bulkExpenseModel>is_planned}"
                    customTextOn="Yes"
                    customTextOff="No"/>

                <Label
                    text="Notes"
                    class="sapUiSmallMarginTop"/>
                <TextArea
                    value="{bulkExpenseModel>notes}"
                    rows="4"
                    growing="true"
                    growingMaxLines="8"
                    width="100%"
                    placeholder="Enter additional expense notes"/>

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Save Details"
                type="Emphasized"
                icon="sap-icon://save"
                press=".onCloseMoreDetails"/>
        </beginButton>

        <endButton>
            <Button
                text="Close"
                type="Transparent"
                press=".onCloseMoreDetails"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
